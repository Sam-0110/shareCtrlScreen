{
  // Signaling / rendezvous server for ShareCtrlScreen.
  // Relays JSON only — never carries video or input data.
  "name": "sharectrl-signal",
  "main": "src/index.js",
  "compatibility_date": "2026-07-01",
  "durable_objects": {
    "bindings": [
      { "name": "SIGNAL", "class_name": "SignalingRoom" },
      // One object per account (src/accounts.js): password hash, sign-in
      // tokens (hashed) and the synced remote-ID list.
      { "name": "ACCOUNTS", "class_name": "AccountStore" }
    ]
  },
  // Per-IP limit on sign-in and sign-up attempts (Workers Rate Limiting).
  // namespace_id is any number unique within the Cloudflare account.
  "ratelimits": [
    {
      "name": "AUTH_LIMITER",
      "namespace_id": "3001",
      "simple": { "limit": 20, "period": 60 }
    }
  ],
  // Must be new_sqlite_classes: only SQLite-backed DOs are allowed on the free plan.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["SignalingRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["AccountStore"] }
  ]
}
